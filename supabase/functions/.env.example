# Secrets for the Edge Functions. Copy to supabase/functions/.env for local
# development; on a hosted project set them with `supabase secrets set`.

# Shared with the database (Vault secret "push_delivery_secret"). It only lets a
# caller start a push delivery run. Generate with: openssl rand -hex 32
PUSH_DELIVERY_SECRET=

# Optional. Only when enhanced push security is on for the Expo project
# (https://expo.dev/settings/access-tokens).
EXPO_ACCESS_TOKEN=

# Invite emails (send-invite-email). The sender, as "Name <address>", on a
# domain verified with the provider.
INVITE_EMAIL_FROM=
# Resend API key (https://resend.com/api-keys), with sending access only.
RESEND_API_KEY=
# Local development only, instead of RESEND_API_KEY: the stack's Mailpit as the
# function's container sees it, so emails appear at http://127.0.0.1:54324.
# MAILPIT_URL=http://supabase_inbucket_FlatMate:8025
