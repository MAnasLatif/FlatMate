# Copy this file to .env and fill in the values.
#
# Variables prefixed EXPO_PUBLIC_ are bundled into the app and can be read by
# anyone who installs it. Never put a secret or the service-role key here.

# URL of your Supabase project (for local development: the API URL printed by `supabase start`)
EXPO_PUBLIC_SUPABASE_URL=

# Public client key of your Supabase project (the anon / publishable key)
EXPO_PUBLIC_SUPABASE_ANON_KEY=
