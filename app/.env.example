# Copy this file to .env and fill in the values.
#
# Variables prefixed EXPO_PUBLIC_ are bundled into the app and can be read by
# anyone who installs it. Never put a secret or the service-role key here.

# URL of your Supabase project (for local development: the API URL printed by `supabase start`)
EXPO_PUBLIC_SUPABASE_URL=

# Publishable key of your Supabase project (starts with sb_publishable_).
# This is the public client key. It is not the secret or service-role key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Set to true to show "Continue with Google" once the Google provider
# is configured in the Supabase project.
EXPO_PUBLIC_AUTH_GOOGLE_ENABLED=false
